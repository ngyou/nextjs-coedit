# Server-side proxy target for app/api/[...path]/route.ts
API_URL=http://localhost:8000/api

# Public app URL used for sharing links and deployment config
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional custom signaling servers for y-webrtc (comma-separated)
# Example: NEXT_PUBLIC_YJS_SIGNALING=ws://localhost:4444,wss://signal.example.com
NEXT_PUBLIC_YJS_SIGNALING=

# Optional Ably API key for realtime relay fallback.
# For production, prefer issuing Ably tokens from your backend instead of exposing an API key.
NEXT_PUBLIC_ABLY_API_KEY=
